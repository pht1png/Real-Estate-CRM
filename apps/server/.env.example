# Copy to .env for local dev. Documentation and types: .env.schema
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
WEB_URL=http://localhost:3001
EMAIL_PROVIDER=log
# EMAIL_FROM=Real Estate CRM <no-reply@example.com>
# RESEND_API_KEY=  (only when EMAIL_PROVIDER=resend)
STORAGE_DRIVER=local
# S3_ENDPOINT= S3_BUCKET= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY=  (only when STORAGE_DRIVER=s3)
# COOKIE_DOMAIN=  (production only, e.g. example.com)
DATABASE_URL=postgresql://postgres:password@localhost:5432/Real-Estate-CRM
