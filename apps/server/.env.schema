# API server environment (Hono on Bun). Source of truth for env vars;
# copy .env.example to .env for local dev. Tests use .env.test (NODE_ENV=test).
# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Signs sessions and tokens. Generate with `openssl rand -base64 32`.
# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Public URL of this API server (Better Auth base URL). https => Secure cookies.
# @public @type=url @example="http://localhost:3000"
BETTER_AUTH_URL=

# Origin of the web app; allowed by CORS (with credentials) and Better Auth trustedOrigins.
# @public @type=url @example="http://localhost:3001"
CORS_ORIGIN=

# Parent domain shared by web and API in production (e.g. example.com for app./api.).
# Leave unset locally; enables cross-subdomain auth cookies when set.
# @optional @public @type=string @example="example.com"
COOKIE_DOMAIN=

# Postgres connection string (standard pg driver; interactive transactions required).
# @type=string(minLength=1) @example="postgresql://postgres:password@localhost:5432/Real-Estate-CRM"
DATABASE_URL=
