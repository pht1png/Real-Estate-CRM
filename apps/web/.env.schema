# Web app environment (Next.js, UI only). Source of truth for env vars;
# copy .env.example to .env for local dev. NEXT_PUBLIC_* values are inlined at build time.
# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Public URL of the API server (tRPC at /trpc, Better Auth at /api/auth).
# @public @type=url @example="http://localhost:3000"
NEXT_PUBLIC_SERVER_URL=
